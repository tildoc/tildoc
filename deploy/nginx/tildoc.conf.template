# tildoc reverse proxy (TLS termination). Rendered by the nginx image's
# envsubst template mechanism: ${TILDOC_SERVER_NAME}, ${TILDOC_UPSTREAM},
# ${TILDOC_OFFICE_SERVER_NAME}, ${TILDOC_OFFICE_URL}, ${TILDOC_OFFICE_UPSTREAM}.
#
# Requirements for tildoc protocols:
#  - stream request bodies (no buffering, no size limit) for large uploads
#  - pass Host incl. port unchanged ($http_host): S3 SigV4 signs it, WebDAV
#    MOVE/COPY compare it with the Destination header
#  - pass the raw request URI (proxy_pass without URI part, merge_slashes off):
#    S3 keys may contain "//" or encoded characters that are signed as sent

merge_slashes off;
server_tokens off;

ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;

map $http_x_forwarded_proto $fwd_proto { default $scheme; }

# --- web UI, REST API, WebDAV -------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${TILDOC_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    add_header Strict-Transport-Security "max-age=31536000" always;

    root /usr/share/nginx/html;

    # the UI build ships .gz next to every asset; API JSON is gzipped (and
    # ETagged) by tildoc itself, so only static text types are listed
    gzip_static on;
    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/css text/javascript application/javascript image/svg+xml;

    location /api/ { proxy_pass http://${TILDOC_UPSTREAM}:8080; }
    location /dav  { proxy_pass http://${TILDOC_UPSTREAM}:8080; }

    location /_app/immutable/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Strict-Transport-Security "max-age=31536000" always;
        # pdf.js runs as an ES module worker (.mjs), which needs a JS MIME type
        location ~ \.mjs$ {
            types { text/javascript mjs; }
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header X-Content-Type-Options "nosniff" always;
            add_header Strict-Transport-Security "max-age=31536000" always;
        }
    }
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Content-Security-Policy "frame-src 'self' ${TILDOC_OFFICE_URL}; form-action 'self' ${TILDOC_OFFICE_URL}" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
}

# --- office server (Collabora or ONLYOFFICE), on its own origin ----------------
# Access tokens appear in its URLs (websocket path), so URLs are not logged.
# Resolved at request time: the service only exists with the compose profile.
log_format office '$remote_addr [$time_local] $host $status $body_bytes_sent';
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 443 ssl;
    server_name ${TILDOC_OFFICE_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    access_log /var/log/nginx/access.log office;
    client_max_body_size 0;
    add_header Strict-Transport-Security "max-age=31536000" always;

    resolver 127.0.0.11 valid=30s;
    set $office_upstream ${TILDOC_OFFICE_UPSTREAM};

    location / {
        proxy_pass http://$office_upstream;
        proxy_http_version 1.1;
        proxy_read_timeout 36000s;
        proxy_send_timeout 36000s;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# --- S3 gateway ---------------------------------------------------------------
server {
    listen 9443 ssl;
    http2 on;
    server_name ${TILDOC_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    ignore_invalid_headers off;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    location / { proxy_pass http://${TILDOC_UPSTREAM}:9000; }
}
