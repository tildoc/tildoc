# tildoc configuration template. Copy to deploy/.env (gitignored) and adjust.
# Generate secrets with: openssl rand -base64 32

# --- required secrets ---------------------------------------------------------
# 32 bytes base64. Encrypts access key secrets at rest. Keep a backup:
# losing it invalidates all access keys (users can create new ones).
TILDOC_MASTER_KEY=CHANGE_ME_openssl_rand_base64_32
POSTGRES_PASSWORD=CHANGE_ME

# --- public endpoints (as clients see them) -----------------------------------
TILDOC_SERVER_NAME=localhost
TILDOC_PUBLIC_URL=https://localhost:8443
TILDOC_S3_PUBLIC_URL=https://localhost:9443
TILDOC_SFTP_PUBLIC_ADDR=localhost:2222
# host ports
TILDOC_HTTPS_PORT=8443
TILDOC_S3_PORT=9443
TILDOC_SFTP_PORT=2222

# --- office documents (optional), see docs/office-servers.md --------------------
# Needs its own subdomain (never the same origin as TILDOC_PUBLIC_URL).
# ONLYOFFICE (the default):
# COMPOSE_PROFILES=onlyoffice
# TILDOC_OFFICE_UPSTREAM=onlyoffice:80
# or Collabora:
# COMPOSE_PROFILES=collabora
# TILDOC_OFFICE_UPSTREAM=collabora:9980
# for either one:
# TILDOC_OFFICE_SERVER_NAME=office.localhost
# TILDOC_OFFICE_URL=https://office.localhost:8443

# --- optional -----------------------------------------------------------------
# TILDOC_S3_REGION=us-east-1
# TILDOC_TRASH_RETENTION=30d
# TILDOC_MAX_UPLOAD_BYTES=53687091200
# TILDOC_WORKER_CONCURRENCY=2
# TILDOC_OCR_ENABLED=true
# TILDOC_OCR_LANGS=deu+eng
# TILDOC_LOG_LEVEL=info
# Server backups are written to the 'backups' volume (/backups in the containers).
# Copy them off the host, e.g.: docker compose -f deploy/docker-compose.yml cp worker:/backups ./backups
